# Copy this file to `.env.local` and fill in your EmailJS keys (https://dashboard.emailjs.com).
# .env.local is gitignored. Restart `npm run dev` after editing.
#
# EmailJS → Email Services  → Service ID
VITE_EMAILJS_SERVICE_ID=
# EmailJS → Email Templates → Template ID
#   template can use: {{from_name}} {{from_email}} {{reply_to}} {{message}} {{to_name}}
VITE_EMAILJS_TEMPLATE_ID=
# EmailJS → Account → General → Public Key
VITE_EMAILJS_PUBLIC_KEY=

# Optional: backend API used by RTK Query
VITE_API_BASE_URL=
